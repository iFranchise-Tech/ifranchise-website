{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ifranchise-website-preview",
  "main": "build/worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Preview database only. Do not copy this id into wrangler.jsonc or production.
  "vars": {
    "SITE_ACCESS": "public",
    "CMS_SUPER_ADMIN_EMAIL": "abdul@ifranchise.in",
    // Set the real Access values with `wrangler secret put` on this Worker only.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ifranchise-db-preview",
      "database_id": "724549ad-1e0a-431b-b15d-192b55e407de",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "ifranchise-files-preview"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  }
}
