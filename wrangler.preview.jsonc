{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ifranchise-website-preview",
  "main": "build/worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Replace database_id after `wrangler d1 create ifranchise-db-preview`.
  // Leave this placeholder until that empty preview database exists.
  // Do not put the production D1 id or the production bucket name here.
  "vars": {
    "SITE_ACCESS": "public",
    "CMS_SUPER_ADMIN_EMAIL": "abdul@ifranchise.in",
    // Set the real Access values with `wrangler secret put` on this Worker only.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ifranchise-db-preview",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "ifranchise-files-preview"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  }
}
