# Documentation only. Set production values in the existing Sites runtime settings.
# Do not copy production delivery credentials into local regression tests.
# Server-only: admin bootstrap identity, signed Google Apps Script endpoint and RSA JWK.
CMS_SUPER_ADMIN_EMAIL=
SHEETS_WEBHOOK_URL=
INTAKE_SIGNING_KEY=
# DB and BUCKET are Cloudflare bindings; no browser credential is needed.
# Never prefix a secret with NEXT_PUBLIC_ or VITE_.
