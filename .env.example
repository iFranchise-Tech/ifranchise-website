# Copy this file to .env at the repository root. Keep real values only in .env.
# Wrangler reads .env for local development when .dev.vars is absent.
# If .dev.vars also exists, Wrangler uses .dev.vars and ignores .env.
# Commented lines are inactive and do not override wrangler.jsonc.
# Never commit .env, .dev.vars, or .secrets/.

# Public website
# No secret is required to browse the site or submit a form into local D1.
# SITE_ACCESS is set to public in wrangler.jsonc. Leave it there.

# Admin sign-in — required before a staff member can open /admin
# Production also needs a Cloudflare Access application limited to:
#   /admin  /admin/*  /api/admin  /api/admin/*
# Uncomment only after those values exist. Empty or placeholder values fail closed.
# ACCESS_TEAM_DOMAIN="https://YOUR-TEAM.cloudflareaccess.com"
# ACCESS_AUD="YOUR-ACCESS-APPLICATION-AUDIENCE"
# CMS_SUPER_ADMIN_EMAIL="owner@ifranchise.in"

# Google Sheets — optional, and off until both values are set
# Generate the key with: node scripts/create-intake-keys.mjs
# Put the public JWK in the Apps Script PUBLIC_KEY. Do not replace the key
# already deployed for the production workbook unless that key is being rotated.
# Delivery has not been verified against a live workbook.
# SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/YOUR-DEPLOYMENT-ID/exec"
# INTAKE_SIGNING_KEY='{"kty":"RSA","n":"REPLACE","e":"AQAB","d":"REPLACE"}'

# One-time brochure import — optional. The admin route still requires this secret or a Super Admin.
# CMS_BROCHURE_IMPORT_TOKEN="replace-with-a-random-secret"
