# Do not create .env when .dev.vars exists. Wrangler ignores .env in that case.
# Wrangler reads this kind of file only when .dev.vars is absent. Use one file.
# The active template is .dev.vars.example. These placeholders match it and stay commented.
# Non-secret settings stay in wrangler.jsonc. The public website needs neither file.
# Never commit .env, .dev.vars, or .secrets/.

# Cloudflare Access — required before staff sign-in can succeed. Localhost still cannot finish it.
# ACCESS_TEAM_DOMAIN="https://team-name.cloudflareaccess.com"
# ACCESS_AUD="paste-the-access-application-audience"

# Google Sheets test copy — optional. Both are required before any row is sent. Not the production workbook.
# SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/TEST-DEPLOYMENT-ID/exec"
# INTAKE_SIGNING_KEY='{"kty":"RSA","n":"REPLACE","e":"AQAB","d":"REPLACE"}'

# One-time brochure import — optional. The route still requires this secret or a Super Admin.
# CMS_BROCHURE_IMPORT_TOKEN="replace-with-a-random-secret"
