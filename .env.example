# Do not create .env when .dev.vars exists. Wrangler ignores .env in that case.
# Wrangler reads this kind of file only when .dev.vars is absent. Use one file.
# The active template is .dev.vars.example. These placeholders match it and stay commented.
# Non-secret settings stay in wrangler.jsonc. The public website needs neither file.
# Never commit .env, .dev.vars, or .secrets/.

# Local admin sign-in — development only. Ignored by preview and production.
# LOCAL_ADMIN_SECRET signs localhost sessions on the server. The account picker never asks for it.
# LOCAL_ADMIN_EMAIL is a legacy setting and does not add accounts to the two-admin picker.
# Generate a secret with: openssl rand -base64 32
# LOCAL_ADMIN_EMAIL="sumanth.reddy@ifranchise.in,abdul@ifranchise.in"
# LOCAL_ADMIN_SECRET="paste-a-random-value-at-least-32-characters"

# Cloudflare Access — required before staff sign-in can succeed on a deployed hostname. Localhost still cannot finish it.
# ACCESS_TEAM_DOMAIN="https://team-name.cloudflareaccess.com"
# ACCESS_AUD="paste-the-access-application-audience"

# Google Sheets test copy — optional. Both are required before any row is sent. Not the production workbook.
# SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/TEST-DEPLOYMENT-ID/exec"
# INTAKE_SIGNING_KEY='{"kty":"RSA","n":"REPLACE","e":"AQAB","d":"REPLACE"}'

# One-time brochure import — optional. The route still requires this secret or a Super Admin.
# CMS_BROCHURE_IMPORT_TOKEN="replace-with-a-random-secret"

# Transactional email — all values are server-side. Never use NEXT_PUBLIC_ or VITE_ prefixes.
# Local capture saves encrypted email payloads without sending mail. No Resend key is needed.
# EMAIL_MODE="capture"
# EMAIL_ENVIRONMENT="development"
# EMAIL_PUBLIC_ORIGIN="http://localhost:3019"
# EMAIL_OUTBOX_KEY="base64-encoded-32-random-bytes"
# For approved local/preview delivery: EMAIL_MODE="resend", EMAIL_ENVIRONMENT="preview".
# Use a separate sending-only Resend key restricted to ifranchise.in.
# RESEND_API_KEY="set-through-your-secret-manager"
# RESEND_WEBHOOK_SECRET="whsec_value-from-the-matching-Resend-webhook"
# EMAIL_ALLOWED_RECIPIENTS="abdul@ifranchise.in,sumanth.reddy@ifranchise.in,it@ifranchise.in,contact@ifranchise.in"
# CMS_NOTIFICATION_TO="it@ifranchise.in"
# WEBSITE_NOTIFICATION_TO="contact@ifranchise.in"
# Hosted origins must be HTTPS. Capture mode is rejected by a production build.
