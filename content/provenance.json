    {
      "id": "lassi-investment",
      "paths": [
        "/franchise/lassi-n-cafe"
      ],
      "severity": "confirm-commercial-term",
      "finding": "Original source investmentMin says \"UF - 15L onwards, 10 Lakhs\", investmentMax says \"₹11 Lakhs\". Conflicting lower figures remain in originalFacts.",
      "recommendation": "Show investment on request / confirm format; do not silently pick a conflicting starting figure."
    },
    {
      "id": "manufactured-investment-maximum",
      "paths": [
        "/franchise/brand-avenue",
        "/franchise/odette"
      ],
      "severity": "source-calculation",
      "finding": "Original function hs creates maxInr=minInr*1.5 when a sole figure has + or onwards. The Brand Avenue ₹45–67.5L range is calculated, not disclosed as a ceiling.",
      "recommendation": "Use original disclosure wording (Brand Avenue ₹45L onwards) and avoid copied fabricated upper bounds."
    },
    {
      "id": "odette-master-incomplete",
      "paths": [
        "/franchise/odette"
      ],
      "severity": "confirm-commercial-term",
      "finding": "investmentMin is \"Units Franchise- 45L, Master Franchise - 1\"; master franchise amount has no denomination.",
      "recommendation": "Use explicit investmentDisplay ₹45 Lakhs onwards; omit incomplete master figure."
    },
    {
      "id": "returns-vs-profit-vs-roi",
      "paths": [
        "/franchise/freshco-goli-soda",
        "/franchise/bigguys",
        "/franchise/odette",
        "/franchise/kasturi-creations"
      ],
      "severity": "avoid-misrepresentation",
      "finding": "Original source parses ROI from generic returns strings. Freshco 85% is described as per-bottle gross margin in whyChoose, but roiPercentage field also says 85%. BIGGUYS ARR ₹32Cr is brand revenue, not investor return. Odette 20% annual ROI field is not reconciled with monthly guarantees/payback; Kasturi 28% annual ROI and five-year payback are not reconciled.",
      "recommendation": "Label exact original fields as brand-provided indicative disclosures, preserve terms and context, avoid ranking by ROI or describing returns as guaranteed by iFranchise."
    },
    {
      "id": "emori-margin-boundaries",
      "paths": [
        "/franchise/emori"
      ],
      "severity": "confirm-commercial-term",
      "finding": "Tiered sales margins specify up to ₹30L, above ₹30L and below ₹50L, and above ₹50L. Exactly ₹50L is not specified.",
      "recommendation": "Preserve disclosed wording, confirm contract thresholds before investor advice."
    },
    {
      "id": "source-placeholder-team",
      "paths": [
        "/team"
      ],
      "severity": "exclude-placeholder",
      "finding": "Original Team page contains John Doe and stock profiles, inconsistent with two named founders on About.",
      "recommendation": "Exclude placeholder team profiles; use Syed Abdul Khader (Founder & Director) and Mohammad Abrar (Co-Founder) as identified on original About page."
    },
    {
      "id": "unsubstantiated-social-proof",
      "paths": [
        "/",
        "/about-us",
        "/services",
        "/list-your-brand"
      ],
      "severity": "exclude-unverified-claim",
      "finding": "Original pages include 15,725 reviews, 100+ brands, 10,000+ inquiries/investors, fictional-looking testimonial records, and demonstration live dashboard numbers; source catalogue has 12 brands.",
      "recommendation": "Do not publish aggregate claims/testimonials without business evidence. Preserve raw extraction solely for audit."
    },
    {
      "id": "brand-reviews",
      "paths": [
        "/franchise/*"
      ],
      "severity": "exclude-unverified-claim",
      "finding": "10 brands have manually embedded Google-labelled ratings and review records, without a captured live provider verification link.",
      "recommendation": "Do not re-publish review schema, ratings, or claims without verification."
    },
    {
      "id": "article-bylines",
      "paths": [
        "/blogs/*"
      ],
      "severity": "confirm-editorial-attribution",
      "finding": "Original articles use named author/advisor profiles and stock avatar URLs. Author identity and authority were not verified.",
      "recommendation": "Use iFranchise editorial attribution if user accepts; retain original authors only in audit until confirmed."
    },
    {
      "id": "legal-stale-processing",
      "paths": [
        "/privacy-policy",
        "/terms-and-conditions",
        "/data-rights-request"
