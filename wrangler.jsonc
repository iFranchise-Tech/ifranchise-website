{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ifranchise-website",
  "main": "build/worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "SITE_ACCESS": "public",
    "CMS_SUPER_ADMIN_EMAIL": "abdul@ifranchise.in,sumanth.reddy@ifranchise.in",
    // Empty Access values fail closed. Put real values in .dev.vars locally,
    // or configure the production Access application before enabling CMS sign-in.
    // Never reuse the preview application's audience for production.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "EMAIL_MODE": "disabled",
    "EMAIL_ENVIRONMENT": "production",
    "EMAIL_PUBLIC_ORIGIN": "https://ifranchise-website.damp-field-d970.workers.dev",
    "WEBSITE_NOTIFICATION_TO": "contact@ifranchise.in",
    "CMS_NOTIFICATION_TO": "it@ifranchise.in"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ifranchise-db",
      "database_id": "f15d6252-c85c-46f8-812b-e03ccafafed8",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "ifranchise-files"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  }
}
